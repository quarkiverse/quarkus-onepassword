<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.quarkiverse.onepassword</groupId>
    <artifactId>quarkus-onepassword-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>quarkus-onepassword</artifactId>
  <name>Quarkus 1Password - Runtime</name>
  <dependencies>
    <dependency>
      <groupId>io.smallrye.common</groupId>
      <artifactId>smallrye-common-process</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ow2.asm</groupId>
      <artifactId>asm</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-extension-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>extension-descriptor</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <deployment>io.quarkiverse.onepassword:quarkus-onepassword-deployment:${project.version}</deployment>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
